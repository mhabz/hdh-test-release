# Example environment variables required for the SSH connection.
# Copy this file to ".env" (not versioned) and fill in real values.
# Never commit the ".env" file.

SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
SSH_PRIVATE_KEY_PASSPHRASE=

# Optional. Where to check the server's host key against.
# Leave unset to use the real ~/.ssh/known_hosts.
# Point it at a project-local file when testing against the local Docker
# target, so your real SSH configuration is never touched (see docs/setup.md).
SSH_KNOWN_HOSTS_PATH=
